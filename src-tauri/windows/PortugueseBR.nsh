; Brazilian Portuguese translations for Tauri's installer and uninstaller messages.
LangString addOrReinstall ${LANG_PORTUGUESEBR} "Adicionar ou reinstalar componentes"
LangString alreadyInstalled ${LANG_PORTUGUESEBR} "Já instalado"
LangString alreadyInstalledLong ${LANG_PORTUGUESEBR} "${PRODUCTNAME} ${VERSION} já está instalado. Escolha o que deseja fazer e clique em Próximo."
LangString appRunning ${LANG_PORTUGUESEBR} "{{product_name}} está em execução. Feche o aplicativo e tente novamente."
LangString appRunningOkKill ${LANG_PORTUGUESEBR} "{{product_name}} está em execução.$\nClique em OK para fechar o aplicativo."
LangString chooseMaintenanceOption ${LANG_PORTUGUESEBR} "Escolha uma opção de manutenção."
LangString chooseHowToInstall ${LANG_PORTUGUESEBR} "Escolha como deseja instalar o ${PRODUCTNAME}."
LangString createDesktop ${LANG_PORTUGUESEBR} "Criar atalho na área de trabalho"
LangString dontUninstall ${LANG_PORTUGUESEBR} "Não desinstalar"
LangString dontUninstallDowngrade ${LANG_PORTUGUESEBR} "Não desinstalar (este instalador exige a desinstalação antes de instalar uma versão anterior)"
LangString failedToKillApp ${LANG_PORTUGUESEBR} "Não foi possível fechar o {{product_name}}. Feche o aplicativo e tente novamente."
LangString installingWebview2 ${LANG_PORTUGUESEBR} "Instalando o WebView2..."
LangString newerVersionInstalled ${LANG_PORTUGUESEBR} "Uma versão mais recente do ${PRODUCTNAME} já está instalada. Se quiser instalar esta versão anterior, recomendamos desinstalar a versão atual primeiro. Escolha o que deseja fazer e clique em Próximo."
LangString older ${LANG_PORTUGUESEBR} "mais antiga"
LangString olderOrUnknownVersionInstalled ${LANG_PORTUGUESEBR} "Uma versão $R4 do ${PRODUCTNAME} já está instalada. Recomendamos desinstalar a versão atual antes de continuar. Escolha o que deseja fazer e clique em Próximo."
LangString silentDowngrades ${LANG_PORTUGUESEBR} "A instalação silenciosa de uma versão anterior está desativada. Use o instalador com interface gráfica.$\n"
LangString unableToUninstall ${LANG_PORTUGUESEBR} "Não foi possível desinstalar."
LangString uninstallApp ${LANG_PORTUGUESEBR} "Desinstalar o ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_PORTUGUESEBR} "Desinstalar antes de instalar"
LangString unknown ${LANG_PORTUGUESEBR} "desconhecida"
LangString webview2AbortError ${LANG_PORTUGUESEBR} "Não foi possível instalar o WebView2. O aplicativo precisa dele para funcionar. Execute o instalador novamente."
LangString webview2DownloadError ${LANG_PORTUGUESEBR} "Não foi possível baixar o WebView2. Erro: $0"
LangString webview2DownloadSuccess ${LANG_PORTUGUESEBR} "Instalador do WebView2 baixado com sucesso"
LangString webview2Downloading ${LANG_PORTUGUESEBR} "Baixando o instalador do WebView2..."
LangString webview2InstallError ${LANG_PORTUGUESEBR} "Não foi possível instalar o WebView2. Código de saída: $1"
LangString webview2InstallSuccess ${LANG_PORTUGUESEBR} "WebView2 instalado com sucesso"
LangString deleteAppData ${LANG_PORTUGUESEBR} "Apagar os dados do aplicativo"
