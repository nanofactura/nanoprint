{
  "name": "nanoprint-landing",
  "private": true,
  "description": "NanoPrint's website, nanoprint.nanofactura.com: a static site deployed to Cloudflare Pages.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/csp-headers.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets": "node scripts/generate-assets.mjs",
    "deploy": "npm run build && node --env-file-if-exists=.env node_modules/wrangler/bin/wrangler.js deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/svelte": "^1.61.0",
    "@point-of-sale/receipt-printer-encoder": "^4.0.1",
    "@sveltejs/kit": "^3.1.0",
    "qz-tray": "^2.3.0",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wrangler": "4.152.0"
  }
}
