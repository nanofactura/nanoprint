# Copy to .env, which git ignores. npm run deploy reads it.

# Only needed when your Cloudflare login can reach several accounts.
CLOUDFLARE_ACCOUNT_ID=

# Not needed after `npx wrangler login`, which keeps its credentials outside the repository. For a
# computer without a browser: an API token limited to "Cloudflare Pages: Edit" on this account.
# CLOUDFLARE_API_TOKEN=
