# Cloudflare Pages response headers. Each page also carries its own Content-Security-Policy in a
# <meta> tag, with the hashes of its inline scripts (vite.config.ts); a header policy adds what a
# <meta> cannot express. Both apply.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'

# File names under /_app/immutable/ change with their content.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
